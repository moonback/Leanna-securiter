# ═══════════════════════════════════════════════════════════════════════════
# Configuration NPM pour Leanna OS
# ═══════════════════════════════════════════════════════════════════════════

# ─── Puppeteer ──────────────────────────────────────────────────────────────
# Empêche Puppeteer de télécharger Chrome/Chromium automatiquement (150+ MB)
# Réduction de la taille d'installation et du temps de npm install
#
# Note : L'automation browser utilisera le Chrome/Chromium du système.
# Pour spécifier un navigateur custom, définir PUPPETEER_EXECUTABLE_PATH dans .env
# Exemple : PUPPETEER_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
puppeteer_skip_download=false
